<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Permissions ───────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Meditation Alarm — wake at a scheduled time to a track or gentle tone -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- AdMob ad ID for personalized ads tracking (Android 13+) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeditationPortal"
        tools:targetApi="34">

        <!-- AdMob App ID — driven from build.gradle manifestPlaceholders.admobAppId
             Currently the official Google TEST ID. Edit one line in build.gradle
             to swap. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Delay app measurement until consent is checked (GDPR/CCPA friendly) -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <!-- Splash screen — procedural 3D opener; leads to MainActivity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal.FullScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal.Splash" />

        <!-- About / Legal / Support screen -->
        <activity
            android:name=".AboutActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <!-- Settings: haptics / sounds / subscription / consent -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <!-- Breathing pacer — interactive box-breathing orb -->
        <activity
            android:name=".BreathingActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal.FullScreen" />

        <!-- Spirit — meditation companion chat -->
        <activity
            android:name=".AiChatActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Meditation Alarm — wake to a guided track or gentle tone -->
        <activity
            android:name=".AlarmActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <!-- Alarm ringing screen — shown full-screen when an alarm fires -->
        <activity
            android:name=".AlarmRingActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait" />

        <!-- UnBound onboarding quiz + paywall (quit-habit + affirmations app).
             Temporary secondary launcher ("UnBound (beta)") so the new funnel can
             be tested on the debug APK without disturbing the existing
             Splash → Main flow. Real entry wiring lands with the Dashboard. -->
        <activity
            android:name=".QuizActivity"
            android:exported="true"
            android:label="Mind &amp; Body Shield"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MeditationPortal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- UnBound home / dashboard (days free, money saved, panic button) -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal" />

        <!-- Affirmation player — habit-aware lines cross-fading over a soundscape -->
        <activity
            android:name=".AffirmationPlayerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal.FullScreen" />

        <!-- Foreground service for background audio playback -->
        <service
            android:name=".SoundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Fires the scheduled meditation alarm and re-arms it after a reboot -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget: streak + today's technique + one-tap meditate -->
        <receiver
            android:name=".StreakWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>

    </application>
</manifest>
