<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Permissions ───────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Daily reminder notification, re-armed after a reboot. The reminder uses
         an inexact alarm (setAndAllowWhileIdle), so no exact-alarm permission
         is required. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- AdMob ad ID for personalized ads tracking (Android 13+) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Restricted "alarm-clock / dialer only" permissions. The app does not
         qualify (Play rejected them under the Full-Screen Intent / core-purpose
         policy). Removing our own declaration is NOT enough: a transitive
         dependency's manifest re-injects USE_FULL_SCREEN_INTENT during the
         merge, so the rejection recurred. tools:node="remove" forces them OUT
         of the final merged manifest no matter which library declares them. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />

    <application
        android:name=".PowerOfMindApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.MeditationPortal"
        tools:targetApi="35">

        <!-- Persists the in-app language choice across launches on API < 33
             (AppCompatDelegate.setApplicationLocales). Disabled component that
             AppCompat enables when autoStoreLocales is on. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Android 16 ignores orientation/resizability restrictions on large
             screens (foldables, tablets) once an app targets SDK 36. The app is
             deliberately portrait-first on phones; this property keeps the
             current large-screen behavior until the layouts are tablet-tested
             (temporary opt-out, honored until targetSdk 37). -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <!-- AdMob App ID — driven from build.gradle manifestPlaceholders.admobAppId
             Currently the official Google TEST ID. Edit one line in build.gradle
             to swap. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Delay app measurement until consent is checked (GDPR/CCPA friendly) -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <!-- Splash screen — procedural 3D opener; leads to Quiz (first run) or Dashboard -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal.FullScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal.Splash" />

        <!-- About / Legal / Support screen -->
        <activity
            android:name=".AboutActivity"
            android:exported="true"
            android:parentActivityName=".DashboardActivity"
            android:screenOrientation="portrait" />

        <!-- Settings: haptics / sounds / subscription / consent -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:parentActivityName=".DashboardActivity"
            android:screenOrientation="portrait" />

        <!-- Breathing pacer — interactive box-breathing orb -->
        <activity
            android:name=".BreathingActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal.FullScreen" />

        <!-- Spirit — meditation companion chat -->
        <activity
            android:name=".AiChatActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Legacy meditation-alarm screen — unreachable from the live app
             (only the old, now-orphaned nav linked here). Kept declared so the
             code compiles; slated for removal in a later cleanup. -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Legacy alarm-ring screen. No longer wired to a full-screen-intent
             notification (that restricted permission was removed); unreachable. -->
        <activity
            android:name=".AlarmRingActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait" />

        <!-- Onboarding quiz + paywall — entered from the splash on first run. -->
        <activity
            android:name=".QuizActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MeditationPortal" />

        <!-- UnBound home / dashboard (days free, money saved, panic button) -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal" />

        <!-- Affirmation player — habit-aware lines cross-fading over a soundscape -->
        <activity
            android:name=".AffirmationPlayerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal.FullScreen" />

        <!-- Affirmation library — browse themed affirmation sets -->
        <activity
            android:name=".AffirmationLibraryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal" />

        <!-- Milestone celebration — gold particle burst on clean-time milestones -->
        <activity
            android:name=".MilestoneActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal.FullScreen" />

        <!-- Get help now — crisis & addiction helplines -->
        <activity
            android:name=".ResourcesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal" />

        <!-- Insights — stats + savings chart -->
        <activity
            android:name=".InsightsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal" />

        <!-- Streak calendar -->
        <activity
            android:name=".CalendarActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal" />

        <!-- Shareable progress card -->
        <activity
            android:name=".ShareActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal" />

        <!-- Favorites — hearted affirmation lines -->
        <activity
            android:name=".FavoritesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeditationPortal" />

        <!-- FileProvider for sharing the generated progress-card image -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Legacy sound-library service — currently unreachable from any live
             navigation path (see SettingsActivity); kept declared since
             SoundService.kt still compiles against it. -->
        <service
            android:name=".SoundService"
            android:exported="false" />

        <!-- Fires the scheduled meditation alarm and re-arms it after a reboot -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget: streak + today's technique + one-tap meditate -->
        <receiver
            android:name=".StreakWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>

    </application>
</manifest>
