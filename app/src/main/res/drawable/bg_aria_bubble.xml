<?xml version="1.0" encoding="utf-8"?>
<!-- ARIA AI chat bubble: dark glass, top-left corner squared for "tail" effect -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:radius="18dp"
        android:topLeftRadius="4dp" />
    <solid android:color="#1C1C3A" />
    <stroke
        android:width="1dp"
        android:color="#2E2E5A" />
</shape>
