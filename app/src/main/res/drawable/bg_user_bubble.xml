<?xml version="1.0" encoding="utf-8"?>
<!-- User chat bubble: deep-pink gradient, top-right corner squared for "tail" effect -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:radius="18dp"
        android:topRightRadius="4dp" />
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#9C0060"
        android:endColor="#E91E8C" />
</shape>
