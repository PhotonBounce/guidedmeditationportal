<?xml version="1.0" encoding="utf-8"?>
<!-- User chat bubble: purple gradient, top-right corner squared for "tail" effect -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:radius="18dp"
        android:topRightRadius="4dp" />
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#7B5EA7"
        android:endColor="#A78BFA" />
</shape>
