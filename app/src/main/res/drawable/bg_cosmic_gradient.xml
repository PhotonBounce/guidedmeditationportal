<?xml version="1.0" encoding="utf-8"?>
<!-- Deep cosmic vertical gradient — sits behind everything as the base sky -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="@color/cosmic_indigo_top"
        android:centerColor="@color/cosmic_indigo_mid"
        android:endColor="@color/cosmic_indigo_bottom" />
</shape>
