<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/card_bg">

    <TextView
        android:id="@+id/onboardingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ Welcome to ZenPulse"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/onboardingDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fall asleep faster with scientifically-designed noise.\n\n• 3 free sounds (White, Pink, Brown)\n• 11 premium sounds (Ocean, Rain, Fire…)\n• 8-hour sleep timer\n• Plays with screen off\n\nUpgrade anytime to unlock everything."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/onboardingOk"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Get Started"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/accent_purple"
        app:cornerRadius="24dp" />

</LinearLayout>
