<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Spirit (AI) message bubble — left-aligned -->
    <LinearLayout
        android:id="@+id/bubbleAria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="64dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvAria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_aria_bubble"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:lineSpacingMultiplier="1.4"
            tools:text="Hello! I'm Spirit, your meditation companion." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSoundChip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="start"
            android:layout_marginTop="6dp"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            android:visibility="gone"
            app:backgroundTint="@color/accent_purple_deep"
            app:cornerRadius="18dp"
            app:strokeColor="@color/accent_iris"
            app:strokeWidth="1dp"
            tools:visibility="visible"
            tools:text="▶ Play 🌙 Nowhere You Need to Be" />

    </LinearLayout>

    <!-- User message bubble — right-aligned -->
    <LinearLayout
        android:id="@+id/bubbleUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_user_bubble"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:lineSpacingMultiplier="1.3"
            tools:text="I need help sleeping" />

    </LinearLayout>

</FrameLayout>
