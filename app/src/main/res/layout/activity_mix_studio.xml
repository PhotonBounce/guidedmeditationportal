<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/deep_navy">

    <!-- ── Header ───────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:background="#E60B0B1E">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textSize="22sp"
            android:textColor="@color/text_primary"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎛️"
            android:textSize="22sp"
            android:paddingEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mix Studio"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Layer sounds for your perfect blend"
                android:textColor="@color/accent_iris"
                android:textSize="11sp" />

        </LinearLayout>

        <com.google.android.material.chip.Chip
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIP"
            android:textSize="10sp"
            android:clickable="false"
            android:focusable="false"
            app:chipBackgroundColor="@color/card_bg"
            app:chipStrokeColor="@color/cat_energy"
            app:chipStrokeWidth="1dp"
            android:textColor="@color/cat_energy" />

    </LinearLayout>

    <!-- ── Scrollable content ────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- Presets label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK PRESETS"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Preset chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:chipSpacingHorizontal="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStorm"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⛈️ Storm Night"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/card_bg"
                        app:chipStrokeColor="@color/cat_mechanical"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFocus"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧠 Deep Focus"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/card_bg"
                        app:chipStrokeColor="@color/cat_synthetic"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipForest"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌿 Forest Walk"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/card_bg"
                        app:chipStrokeColor="@color/cat_nature"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBaby"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👶 Baby Sleep"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/card_bg"
                        app:chipStrokeColor="@color/cat_ambient"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCampfire"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 Campfire Night"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/card_bg"
                        app:chipStrokeColor="@color/cat_energy"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOffice"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏢 Office Hum"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/card_bg"
                        app:chipStrokeColor="@color/cat_mechanical"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSpa"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧘 Spa Zen"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/card_bg"
                        app:chipStrokeColor="@color/cat_ambient"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipShuffle"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎲 Shuffle"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/card_bg"
                        app:chipStrokeColor="@color/cat_energy"
                        app:chipStrokeWidth="1dp" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Layer count label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="YOUR MIX"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.18"
                    android:textAllCaps="true"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLayerCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 / 3 layers"
                    android:textColor="@color/accent_iris"
                    android:textSize="11sp"
                    tools:text="2 / 3 layers" />

            </LinearLayout>

            <!-- Layer cards (added programmatically) -->
            <LinearLayout
                android:id="@+id/containerLayers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Save / Load mix buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveMix"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:text="💾  Save Mix"
                    android:textColor="@color/cat_nature"
                    android:textSize="13sp"
                    app:strokeColor="@color/cat_nature"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoadMix"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="📂  My Mixes"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <!-- Add Layer button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddLayer"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="＋  Add Sound Layer"
                android:textColor="@color/accent_iris"
                android:textSize="14sp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="14dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/card_border"
                android:alpha="0.4"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp" />

            <!-- Status -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to play"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="14dp"
                tools:text="▶ Mix playing" />

            <!-- Play / Stop buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStop"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:text="⏹ Stop"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlay"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="52dp"
                    android:text="▶  Play Mix"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_iris"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
