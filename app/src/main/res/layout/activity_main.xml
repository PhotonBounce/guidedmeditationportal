<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_navy"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙 SoundPad"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvNowPlaying"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap a sound to begin"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="🌸 Pink Noise" />

        <!-- ── Sound grid ──────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="SOUNDS"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.15" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSounds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_sound_card"
            tools:itemCount="14" />

        <!-- ── Volume ─────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:textSize="18sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:valueFrom="0.0"
                app:valueTo="1.0"
                app:stepSize="0.0"
                android:value="0.7"
                app:thumbColor="@color/accent_purple"
                app:trackColorActive="@color/accent_purple"
                app:trackColorInactive="@color/card_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔉"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ── Timer countdown display ────────────────────────────────── -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:textColor="@color/accent_teal"
            android:textSize="15sp"
            android:fontFamily="monospace"
            tools:text="⏱ 29:45" />

        <!-- ── Controls row ───────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayStop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.6"
                android:text="▶ Play Last"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/accent_purple"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTimer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="⏱ Timer"
                android:textSize="13sp"
                android:textColor="@color/accent_teal"
                app:strokeColor="@color/accent_teal"
                app:cornerRadius="28dp" />

        </LinearLayout>

        <!-- ── Premium upgrade card ───────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPremium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/card_premium_bg"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/premium_gold"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ SoundPad Pro"
                    android:textColor="@color/premium_gold"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="All 14 sounds · No ads · 8-hour timer"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPremium"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Unlock — \$3.99"
                        android:textColor="@color/deep_navy"
                        android:textSize="13sp"
                        app:backgroundTint="@color/premium_gold"
                        app:cornerRadius="22dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubscribe"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="\$1.99/mo"
                        android:textColor="@color/premium_gold"
                        android:textSize="13sp"
                        app:strokeColor="@color/premium_gold"
                        app:cornerRadius="22dp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── AdMob banner ───────────────────────────────────────────── -->
        <!-- Replace adUnitId with your real banner ID from AdMob console -->
        <com.google.android.gms.ads.AdView
            xmlns:ads="http://schemas.android.com/apk/res-auto"
            android:id="@+id/adView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
