<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cosmic_gradient"
    tools:context=".MainActivity">

    <!-- ── Animated starfield behind everything ──────────────────────────── -->
    <com.auroramind.meditation.NightSkyView
        android:id="@+id/nightSky"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- watermark logo removed per UX review — top logo (ivTopLogo) is sufficient -->

    <!-- ── Main vertical container ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
                app:title=""
                app:titleTextColor="@color/text_primary" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Scrollable Sound Grid and explainer card -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/mainScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/content_horizontal_padding"
                android:paddingEnd="@dimen/content_horizontal_padding"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/ivTopLogo"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/appicon"
                        android:background="@drawable/bg_logo_ring"
                        android:padding="2dp"
                        android:clipToOutline="true"
                        android:contentDescription="Portal Logo" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/hero_text_size"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvVersionBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_gravity="bottom"
                            android:textColor="@color/accent_iris"
                            android:textSize="9sp"
                            tools:text="v1.0.3" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ── Progress / streak banner (tap for full stats) ─────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#1A2A0D1E"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/accent_purple_deep"
                    app:rippleColor="@color/ripple_color">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="10dp"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvStreak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/accent_purple_light"
                                android:textSize="19sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔥 day streak"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvTotalSessions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/accent_purple_light"
                                android:textSize="19sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🧘 sessions"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvTotalMinutes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/accent_purple_light"
                                android:textSize="19sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏳ minutes"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── Daily inspirational quote ─────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#14FFFFFF"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="18dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/tvQuote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="“Breathe. You are exactly where you need to be.”"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="italic"
                            android:lineSpacingExtra="3dp" />
                        <TextView
                            android:id="@+id/tvQuoteAuthor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="— Spirit"
                            android:textColor="@color/accent_purple_light"
                            android:textSize="12sp"
                            android:gravity="end" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── Tools row: Breathe + Quick Calm ───────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBreathe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#1A2A0D1E"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="18dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/accent_teal"
                        app:rippleColor="@color/ripple_color">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🫧"
                                android:textSize="26sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Breathe"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Box breathing"
                                android:textColor="@color/accent_teal"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardQuickCalm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#1A2A0D1E"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="18dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/premium_gold"
                        app:rippleColor="@color/ripple_color">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚡"
                                android:textSize="26sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Quick Calm"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="60-second reset"
                                android:textColor="@color/premium_gold"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ── ARIA AI Chat Card ────────────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAiChat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="18dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/accent_iris"
                    app:rippleColor="@color/ripple_color">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_ai_glow"
                        android:padding="10dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:text="🤖"
                            android:textSize="22sp"
                            android:gravity="center" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Spirit"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your inspirational meditation companion"
                                android:textColor="@color/accent_iris"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→"
                            android:textColor="@color/accent_iris"
                            android:textSize="22sp"
                            android:paddingEnd="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── Alarm Clock Card (New Home Screen Shortcut) ───────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="18dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/accent_teal"
                    app:rippleColor="@color/ripple_color">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_ai_glow"
                        android:backgroundTint="#2600E5FF"
                        android:padding="10dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:text="⏰"
                            android:textSize="22sp"
                            android:gravity="center" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Meditation Alarm"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wake gently to a guided meditation or soft tone"
                                android:textColor="@color/accent_teal"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→"
                            android:textColor="@color/accent_teal"
                            android:textSize="22sp"
                            android:paddingEnd="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── Mood / goal filter chips ──────────────────────────────── -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupMoods"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAll"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All"
                            android:checked="true" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSleep"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌙 Sleep" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipStress"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌬️ Stress &amp; Anxiety" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFocus"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯 Focus" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipGrounding"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌿 Grounding" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCompassion"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🤍 Self-Compassion" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipEnergy"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ Energy" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- ── Sound grid ─────────────────────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="SOUNDS"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:letterSpacing="0.18"
                    android:fontFamily="sans-serif-medium" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSounds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    tools:listitem="@layout/item_sound_card"
                    tools:itemCount="14" />

                <!-- ── Premium aurora card ────────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPremium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="20dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_premium_aurora"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨ Unlock the Full Portal"
                            android:textColor="@color/premium_gold_light"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Every guided meditation · Spirit companion · Meditation alarm · No ads — one time, forever\n🔜 More sounds &amp; languages coming soon!"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPremium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="46dp"
                            android:layout_marginTop="16dp"
                            android:text="✨ Unlock forever — \$2.00"
                            android:textColor="@color/cosmic_indigo_top"
                            android:textSize="13sp"
                            app:backgroundTint="@color/premium_gold"
                            app:cornerRadius="23dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── Adaptive AdMob banner container ─────────────────────── -->
                <FrameLayout
                    android:id="@+id/adContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ── Persistent Elegant Player Control Card (Pinned) ─────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBottomControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#E616162E"
            app:cardElevation="8dp"
            app:cardCornerRadius="18dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_border"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Volume slider row -->
                <LinearLayout
                    android:id="@+id/rowVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔉"
                        android:textSize="15sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderVolume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:valueFrom="0.08"
                        android:valueTo="1.0"
                        android:stepSize="0.0"
                        android:value="0.7"
                        app:thumbColor="@color/accent_iris"
                        app:trackColorActive="@color/accent_iris"
                        app:trackColorInactive="@color/card_border"
                        app:haloColor="#33E91E8C" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔊"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Background Volume slider row -->
                <LinearLayout
                    android:id="@+id/rowBgVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎵"
                        android:textSize="15sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderBgVolume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:valueFrom="0.0"
                        android:valueTo="1.0"
                        android:stepSize="0.0"
                        android:value="0.11"
                        app:thumbColor="@color/accent_teal"
                        app:trackColorActive="@color/accent_teal"
                        app:trackColorInactive="@color/card_border"
                        app:haloColor="#3300E5FF" />

                    <TextView
                        android:id="@+id/tvBgVolPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="11%"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Background Music selection row -->
                <LinearLayout
                    android:id="@+id/rowBgMusic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BGM:"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerBgMusic"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/text_primary"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <!-- Now Playing and Timer text info -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tvNowPlaying"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/tvTimer"
                        android:text="Tap a sound to begin"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:ellipsize="end"
                        android:maxLines="2" />

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:textColor="@color/accent_teal"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.05" />
                </RelativeLayout>

                <!-- Scrub bar: elapsed | seek slider | total -->
                <LinearLayout
                    android:id="@+id/rowScrub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvScrubElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="38dp"
                        android:text="0:00"
                        android:gravity="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderScrub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:valueFrom="0.0"
                        android:valueTo="1.0"
                        android:stepSize="0.0"
                        android:value="0.0"
                        app:thumbRadius="7dp"
                        app:trackHeight="3dp"
                        app:thumbColor="@color/accent_iris"
                        app:trackColorActive="@color/accent_iris"
                        app:trackColorInactive="@color/card_border"
                        app:haloColor="#33E91E8C"
                        app:labelBehavior="gone" />

                    <TextView
                        android:id="@+id/tvScrubTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="38dp"
                        android:text="0:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Play, Previous, Next, Timer, Random row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrevious"
                        android:contentDescription="Previous track"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="⏮"
                        android:textSize="18sp"
                        android:textColor="@color/text_secondary"
                        app:rippleColor="@color/ripple_color"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1.5">

                        <com.auroramind.meditation.CircularTimerRingView
                            android:id="@+id/timerRing"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlayStop"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:layout_gravity="center"
                            android:layout_margin="2dp"
                            android:text="▶ Play Last"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/bg_play_button_gradient"
                            app:cornerRadius="20dp"
                            app:backgroundTint="@null" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNext"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="Next track"
                        android:text="⏭"
                        android:textSize="18sp"
                        android:textColor="@color/text_secondary"
                        app:rippleColor="@color/ripple_color"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRepeat"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="40dp"
                        android:layout_height="44dp"
                        android:contentDescription="Repeat mode"
                        android:text="🔁"
                        android:textSize="16sp"
                        android:textColor="@color/text_secondary"
                        app:rippleColor="@color/ripple_color"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTimer"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="40dp"
                        android:layout_height="44dp"
                        android:contentDescription="Sleep timer"
                        android:text="⏱"
                        android:textSize="16sp"
                        android:textColor="@color/accent_teal"
                        app:rippleColor="@color/ripple_color"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRandom"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="40dp"
                        android:layout_height="44dp"
                        android:contentDescription="Shuffle / random meditation"
                        android:text="🎲"
                        android:textSize="16sp"
                        android:textColor="@color/premium_gold"
                        app:rippleColor="@color/ripple_color"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Premium Bottom Navigation Bar (Pinned) ──────────────────── -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F00B0B1E"
            app:menu="@menu/menu_bottom_nav"
            app:itemIconTint="@color/accent_purple_light"
            app:itemTextColor="@color/text_secondary"
            app:labelVisibilityMode="labeled" />

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
