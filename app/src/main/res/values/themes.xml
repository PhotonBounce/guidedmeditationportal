<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SoundPad" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_iris</item>
        <item name="colorPrimaryVariant">@color/cosmic_indigo_top</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/cosmic_indigo_top</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/cosmic_indigo_top</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:windowBackground">@drawable/bg_cosmic_gradient</item>
        <!-- Edge-to-edge: transparent system bars, content draws under them -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast"      tools:targetApi="29">false</item>
    </style>

    <!-- Dark alert dialog style — used for upgrade & timer dialogs -->
    <style name="AlertDialogDark" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:background">@color/card_bg</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertBtn</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertBtn</item>
        <item name="buttonBarNeutralButtonStyle">@style/AlertBtn</item>
    </style>

    <style name="AlertBtn" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_iris</item>
    </style>

</resources>
