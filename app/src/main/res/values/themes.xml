<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MeditationPortal" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_iris</item>
        <item name="colorPrimaryVariant">@color/cosmic_indigo_top</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/cosmic_indigo_top</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/cosmic_indigo_top</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:windowBackground">@drawable/bg_cosmic_gradient</item>
        <!-- Edge-to-edge is enabled at runtime via enableEdgeToEdge() in each
             activity. statusBarColor/navigationBarColor theme attrs are
             deprecated in Android 15 and must not be set here. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <!-- Dark alert dialog style — used for upgrade, timer, journeys & progress dialogs.
         Parent is the fully-DARK Material dialog theme (not a DayNight overlay) so list
         items and message text stay light-on-dark even when the device is in light mode. -->
    <style name="AlertDialogDark" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <!-- Message body & list subtitles use textColorSecondary — must be LIGHT
             on our dark surface, or it renders near-black and unreadable. -->
        <item name="android:textColorSecondary">@color/text_primary</item>
        <item name="android:textColorTertiary">@color/text_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:background">@color/card_bg</item>
        <item name="materialAlertDialogTitleTextStyle">@style/AlertTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/AlertBodyText</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertBtn</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertBtn</item>
        <item name="buttonBarNeutralButtonStyle">@style/AlertBtn</item>
    </style>

    <style name="AlertTitleText" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="AlertBodyText" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="AlertBtn" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_iris</item>
    </style>

</resources>
