<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Launched at app start, swapped to Theme.SoundPad once UI is ready -->
    <style name="Theme.SoundPad.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cosmic_indigo_top</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/appicon</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/cosmic_indigo_top</item>
        <item name="postSplashScreenTheme">@style/Theme.SoundPad</item>
    </style>

</resources>
